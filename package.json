{
  "name": "qti3",
  "version": "0.0.0",
  "private": true,
  "author": {
    "name": "Sam Ottenhoff",
    "url": "https://github.com/ottenhoff"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:conformance": "vitest run packages/conformance",
    "test:external": "vitest run packages/conformance/src/external-qti.test.ts",
    "test:a11y": "vitest run packages/a11y",
    "test:browser": "playwright test",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check:pack": "node scripts/check-pack-contents.mjs",
    "build": "tsc -b",
    "pages:build": "vite build examples/manual --base /qti3/ --outDir ../../dist/pages --emptyOutDir",
    "dev": "vite --host 127.0.0.1 examples/manual",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:conformance && pnpm test:a11y && pnpm check:deps && pnpm build && pnpm check:exports && pnpm check:pack",
    "release:check": "pnpm verify && pnpm test:browser && node packages/cli/dist/index.js assert-support && node packages/cli/dist/index.js run-fixtures"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "22.19.19",
    "axe-core": "4.11.4",
    "oxfmt": "0.49.0",
    "oxlint": "1.64.0",
    "typescript": "6.0.3",
    "vite": "8.0.12",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.1"
}

{
  "name": "@longsightgroup/qti3-player-preact",
  "version": "0.9.10",
  "description": "Preact TSX adapter for the qti3 QTI 3 assessment item player web component.",
  "keywords": [
    "assessment",
    "preact",
    "qti",
    "qti3",
    "tsx",
    "web-components"
  ],
  "homepage": "https://github.com/LongsightGroup/qti3/tree/main/packages/player-preact#readme",
  "bugs": {
    "url": "https://github.com/LongsightGroup/qti3/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Sam Ottenhoff",
    "url": "https://github.com/ottenhoff"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LongsightGroup/qti3.git",
    "directory": "packages/player-preact"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "!dist/**/*.test.*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prepublishOnly": "pnpm --dir ../.. release:check"
  },
  "dependencies": {
    "@longsightgroup/qti3-player": "workspace:*"
  },
  "devDependencies": {
    "preact": "10.29.2"
  },
  "peerDependencies": {
    "preact": ">=10.26 <11"
  }
}

{
  "name": "@longsightgroup/qti3-cli",
  "version": "0.2.0",
  "description": "Command-line tools for parsing, validating, scoring, inspecting, and checking QTI 3 items.",
  "keywords": [
    "assessment",
    "cli",
    "qti",
    "qti3",
    "typescript",
    "validation"
  ],
  "homepage": "https://github.com/LongsightGroup/qti3/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/LongsightGroup/qti3/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Sam Ottenhoff",
    "url": "https://github.com/ottenhoff"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LongsightGroup/qti3.git",
    "directory": "packages/cli"
  },
  "bin": {
    "qti3": "./dist/index.js"
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "dist/*.js",
    "dist/*.js.map",
    "!dist/*.test.*",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prepublishOnly": "pnpm --dir ../.. release:check"
  },
  "dependencies": {
    "@longsightgroup/qti3-a11y": "workspace:*",
    "@longsightgroup/qti3-conformance": "workspace:*",
    "@longsightgroup/qti3-core": "workspace:*",
    "@longsightgroup/qti3-fixtures": "workspace:*",
    "stax-xml": "0.7.0"
  }
}

{
  "name": "@longsightgroup/qti3-conformance",
  "version": "0.9.2",
  "description": "Fixture runner and conformance helpers for qti3 QTI 3 assessment items.",
  "keywords": [
    "assessment",
    "conformance",
    "fixtures",
    "qti",
    "qti3",
    "typescript"
  ],
  "homepage": "https://github.com/LongsightGroup/qti3/tree/main/packages/conformance#readme",
  "bugs": {
    "url": "https://github.com/LongsightGroup/qti3/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Sam Ottenhoff",
    "url": "https://github.com/ottenhoff"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LongsightGroup/qti3.git",
    "directory": "packages/conformance"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "!dist/**/*.test.*",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prepublishOnly": "pnpm --dir ../.. release:check"
  },
  "dependencies": {
    "@longsightgroup/qti3-core": "workspace:*",
    "@longsightgroup/qti3-fixtures": "workspace:*"
  }
}

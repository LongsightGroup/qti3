  "diagnostics": [
    {
      "code": "source.interaction.deprecated",
      "message": "qti-custom-interaction is deprecated. Deprecated in favor of qti-portable-custom-interaction.",
      "path": "/qti-assessment-item/qti-item-body[1]/qti-custom-interaction[1]",
      "severity": "warning",
    },
    {
      "code": "profile.qti2.custom.preserved",
      "message": "Preserved custom interaction configuration and markup in a foreign-namespace payload.",
      "path": "/itemBody/interactions/0",
      "severity": "info",
    },
  ],
  "report": {
    "affectedPaths": [
      "/qti-assessment-item/qti-item-body[1]/qti-custom-interaction[1]",
      "/itemBody/interactions/0",
    ],
    "diagnosticCodes": [
      "source.interaction.deprecated",
      "profile.qti2.custom.preserved",
    ],
    "fidelity": "lossy",
    "identifier": "custom-reference",
    "mappings": [
      {
        "affectedPaths": [
          "/itemBody/interactions/0",
        ],
        "diagnosticCodes": [
          "profile.qti2.custom.preserved",
        ],
        "emittedInteraction": "customInteraction",
        "fallback": undefined,
        "fidelity": "normalized",
        "index": 0,
        "scoring": "unscored",
        "sourceInteraction": "custom",
      },
    ],
    "sourcePath": "custom.xml",
  },
  "xml": "<?xml version="1.0" encoding="UTF-8"?>
<assessmentItem xmlns="http://www.imsglobal.org/xsd/imsqti_v2p1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqti_v2p1 https://www.imsglobal.org/xsd/imsqti_v2p1p2.xsd" identifier="custom-reference" title="Custom reference" adaptive="false" timeDependent="false" xml:lang="en-US">
  <responseDeclaration identifier="RESPONSE" cardinality="single" baseType="string"></responseDeclaration>
  <outcomeDeclaration identifier="SCORE" cardinality="single" baseType="float"><defaultValue><value>0</value></defaultValue></outcomeDeclaration>

  <itemBody><p>Use the widget.</p><customInteraction responseIdentifier="RESPONSE"><qti3t:source xmlns:qti3t="urn:longsightgroup:qti3-transcoder:custom:v1" encoding="application/json">{"sourceType":"custom","dataAttributes":{},"attributes":{"response-identifier":"RESPONSE"},"markup":"\\n      &lt;div class=\\"widget\\"&gt;Ready&lt;/div&gt;\\n    "}</qti3t:source></customInteraction></itemBody>
  <responseProcessing>
  <setOutcomeValue identifier="SCORE">
    <baseValue baseType="float">0</baseValue>
  </setOutcomeValue>
</responseProcessing>
</assessmentItem>",
}
`;


<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2.xsd">
  <item ident="associate-reference" title="associate-reference">

    <presentation>
      <material><mattext texttype="text/html">A media-literacy item asks the student to connect a source detail with the reason it is useful. Choose the two details that belong together in a source-evaluation note.</mattext></material>


      <response_grp ident="RESPONSE" rcardinality="Multiple"><render_choice shuffle="No"><response_label ident="A"><material><mattext texttype="text/plain">Interview with the park ranger who led the restoration project</mattext></material></response_label><response_label ident="B"><material><mattext texttype="text/plain">Firsthand source for project timeline</mattext></material></response_label><response_label ident="C"><material><mattext texttype="text/plain">Anonymous comment on a neighborhood forum</mattext></material></response_label><response_label ident="D"><material><mattext texttype="text/plain">Decorative map border</mattext></material></response_label><response_label ident="E"><material><mattext texttype="text/plain">Weather forecast for next month</mattext></material></response_label></render_choice></response_grp>
    </presentation>
    <resprocessing>
      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0"/></outcomes>
      <respcondition continue="No"><conditionvar><other/></conditionvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;

exports[`qti12-standard@1 evidence > transcodes choice 1`] = `
{
  "diagnostics": [],
  "report": {
    "affectedPaths": [],
    "diagnosticCodes": [],
    "fidelity": "exact",
    "identifier": "choice-reference",
    "mappings": [
      {
        "affectedPaths": [],
        "diagnosticCodes": [],
        "emittedInteraction": "response_lid",
        "fallback": undefined,
        "fidelity": "exact",
        "index": 0,
        "scoring": "automatic",
        "sourceInteraction": "choice",
      },
    ],
    "sourcePath": "choice.xml",
  },
  "xml": "<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2.xsd">
  <item ident="choice-reference" title="choice-reference">

    <presentation>
      <material><mattext texttype="text/html">A civics item asks the student to choose the strongest evidence for a local-news claim. A local newspaper reports that the library's weekend tutoring program improved attendance. Which detail would best support that claim?</mattext></material>


      <response_lid ident="RESPONSE" rcardinality="Single">
        <render_choice shuffle="No"><response_label ident="A"><material><mattext texttype="text/plain">Attendance records show that average Saturday visits rose from 42 to 68 students after tutoring began.</mattext></material></response_label><response_label ident="B"><material><mattext texttype="text/plain">The library repainted the study room in a brighter color during spring break.</mattext></material></response_label><response_label ident="C"><material><mattext texttype="text/plain">Several tutors said they enjoyed helping younger students with homework.</mattext></material></response_label><response_label ident="D"><material><mattext texttype="text/plain">The tutoring flyers used the same logo as the summer reading program.</mattext></material></response_label><response_label ident="E"><material><mattext texttype="text/plain">The library closes one hour earlier on Sundays than it does on Saturdays.</mattext></material></response_label></render_choice>
      </response_lid>
    </presentation>
    <resprocessing>
      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0"/></outcomes>
      <respcondition continue="Yes"><conditionvar><varequal respident="RESPONSE">A</varequal></conditionvar><setvar action="Add" varname="SCORE">1</setvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;


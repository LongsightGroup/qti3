esponse_label ident="PAIR_C_C"><material><mattext texttype="text/plain">Analyze results — Analyze results</mattext></material></response_label><response_label ident="PAIR_C_D"><material><mattext texttype="text/plain">Analyze results — Report recommendations</mattext></material></response_label><response_label ident="PAIR_C_E"><material><mattext texttype="text/plain">Analyze results — Community meeting</mattext></material></response_label><response_label ident="PAIR_D_A"><material><mattext texttype="text/plain">Report recommendations — Plan sampling route</mattext></material></response_label><response_label ident="PAIR_D_B"><material><mattext texttype="text/plain">Report recommendations — Collect water data</mattext></material></response_label><response_label ident="PAIR_D_C"><material><mattext texttype="text/plain">Report recommendations — Analyze results</mattext></material></response_label><response_label ident="PAIR_D_D"><material><mattext texttype="text/plain">Report recommendations — Report recommendations</mattext></material></response_label><response_label ident="PAIR_D_E"><material><mattext texttype="text/plain">Report recommendations — Community meeting</mattext></material></response_label><response_label ident="PAIR_E_A"><material><mattext texttype="text/plain">Community meeting — Plan sampling route</mattext></material></response_label><response_label ident="PAIR_E_B"><material><mattext texttype="text/plain">Community meeting — Collect water data</mattext></material></response_label><response_label ident="PAIR_E_C"><material><mattext texttype="text/plain">Community meeting — Analyze results</mattext></material></response_label><response_label ident="PAIR_E_D"><material><mattext texttype="text/plain">Community meeting — Report recommendations</mattext></material></response_label><response_label ident="PAIR_E_E"><material><mattext texttype="text/plain">Community meeting — Community meeting</mattext></material></response_label></render_choice></response_lid>

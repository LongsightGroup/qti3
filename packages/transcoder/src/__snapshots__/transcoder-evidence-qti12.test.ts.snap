      <respcondition continue="Yes"><conditionvar><and><varequal respident="RESPONSE" index="1">A</varequal><varequal respident="RESPONSE" index="2">B</varequal><varequal respident="RESPONSE" index="3">D</varequal><varequal respident="RESPONSE" index="4">C</varequal></and></conditionvar><setvar action="Add" varname="SCORE">1</setvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;


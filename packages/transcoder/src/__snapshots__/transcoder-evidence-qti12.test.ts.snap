  "diagnostics": [
    {
      "code": "profile.qti12.fallback.choice",
      "message": "Converted the relationship task to explicit labeled relationship choices with equivalent deterministic scoring.",
      "path": "graphicGapMatch.xml",
      "severity": "warning",
    },
  ],
  "report": {
    "affectedPaths": [
      "graphicGapMatch.xml",
    ],
    "diagnosticCodes": [
      "profile.qti12.fallback.choice",
    ],
    "fidelity": "lossy",
    "identifier": "graphicGapMatch-reference",
    "mappings": [
      {
        "affectedPaths": [
          "graphicGapMatch.xml",
        ],
        "diagnosticCodes": [
          "profile.qti12.fallback.choice",
        ],
        "emittedInteraction": "response_lid",
        "fallback": "choice",
        "fidelity": "lossy",
        "index": 0,
        "scoring": "automatic",
        "sourceInteraction": "graphicGapMatch",
      },
    ],
    "sourcePath": "graphicGapMatch.xml",
  },
  "xml": "<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2.xsd">
  <item ident="graphicGapMatch-reference" title="graphicGapMatch-reference">

    <presentation>
      <material><mattext texttype="text/html">A diagram-labeling item asks the student to complete two workflow labels from a word bank. Complete the field-study workflow labels.</mattext></material>
      <material><matimage uri="hotspot-flow-unlabeled.svg" imagtype="image/svg+xml" label="Question media" width="480" height="300"></matimage></material>

      <response_lid ident="RESPONSE" rcardinality="Multiple"><material><mattext texttype="text/plain">Select the correct relationships.</mattext></material><render_choice shuffle="No"><response_label ident="PAIR_A_G1"><material><mattext texttype="text/plain">Plan route — G1</mattext></material></response_label><response_label ident="PAIR_A_G2"><material><mattext texttype="text/plain">Plan route — G2</mattext></material></response_label><response_label ident="PAIR_B_G1"><material><mattext texttype="text/plain">Collect data — G1</mattext></material></response_label><response_label ident="PAIR_B_G2"><material><mattext texttype="text/plain">Collect data — G2</mattext></material></response_label><response_label ident="PAIR_C_G1"><material><mattext texttype="text/plain">Analyze results — G1</mattext></material></response_label><response_label ident="PAIR_C_G2"><material><mattext texttype="text/plain">Analyze results — G2</mattext></material></response_label><response_label ident="PAIR_D_G1"><material><mattext texttype="text/plain">Hold celebration — G1</mattext></material></response_label><response_label ident="PAIR_D_G2"><material><mattext texttype="text/plain">Hold celebration — G2</mattext></material></response_label></render_choice></response_lid>
    </presentation>
    <resprocessing>
      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0"/></outcomes>
      <respcondition continue="Yes"><conditionvar><and><varequal respident="RESPONSE">PAIR_A_G1</varequal><varequal respident="RESPONSE">PAIR_B_G2</varequal><not><varequal respident="RESPONSE">PAIR_A_G2</varequal></not><not><varequal respident="RESPONSE">PAIR_B_G1</varequal></not><not><varequal respident="RESPONSE">PAIR_C_G1</varequal></not><not><varequal respident="RESPONSE">PAIR_C_G2</varequal></not><not><varequal respident="RESPONSE">PAIR_D_G1</varequal></not><not><varequal respident="RESPONSE">PAIR_D_G2</varequal></not></and></conditionvar><setvar action="Add" varname="SCORE">1</setvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;


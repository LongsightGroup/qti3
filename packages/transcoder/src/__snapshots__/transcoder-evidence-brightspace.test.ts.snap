  <responseDeclaration identifier="RESPONSE" cardinality="single" baseType="string"></responseDeclaration>
  <outcomeDeclaration identifier="SCORE" cardinality="single" baseType="float"><defaultValue><value>0</value></defaultValue></outcomeDeclaration>

  <itemBody><p>A coordinate item asks the student to mark the center of the data-collection workflow step.</p><extendedTextInteraction responseIdentifier="RESPONSE"><prompt>Mark the center of the Collect water data step, where students record the stream measurements.<object data="hotspot-flow.svg" type="image/svg+xml" width="480" height="300"></object></prompt></extendedTextInteraction></itemBody>

</assessmentItem>",
}
`;


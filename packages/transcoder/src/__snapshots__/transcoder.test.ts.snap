  },
  "xml": "<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2.xsd">
  <item ident="match-reference" title="match-reference">

    <presentation>
      <material><mattext texttype="text/html">A garden-data item asks the student to match observations with reasonable interpretations. Match each observation from a community garden study with the most reasonable interpretation.</mattext></material>


      <response_lid ident="A" rcardinality="Single">
        <material><mattext texttype="text/plain">Mulched beds stayed moist two days longer after watering.</mattext></material>
        <render_choice shuffle="No"><response_label ident="G1"><material><mattext texttype="text/plain">Mulch helped reduce water loss from the soil.</mattext></material></response_label><response_label ident="G2"><material><mattext texttype="text/plain">Bare soil may need more frequent weeding.</mattext></material></response_label><response_label ident="G3"><material><mattext texttype="text/plain">Light exposure was not identical across all beds.</mattext></material></response_label><response_label ident="G4"><material><mattext texttype="text/plain">This maintenance detail does not explain plant growth.</mattext></material></response_label></render_choice>
      </response_lid><response_lid ident="B" rcardinality="Single">
        <material><mattext texttype="text/plain">Uncovered beds had more weeds by the third week.</mattext></material>
        <render_choice shuffle="No"><response_label ident="G1"><material><mattext texttype="text/plain">Mulch helped reduce water loss from the soil.</mattext></material></response_label><response_label ident="G2"><material><mattext texttype="text/plain">Bare soil may need more frequent weeding.</mattext></material></response_label><response_label ident="G3"><material><mattext texttype="text/plain">Light exposure was not identical across all beds.</mattext></material></response_label><response_label ident="G4"><material><mattext texttype="text/plain">This maintenance detail does not explain plant growth.</mattext></material></response_label></render_choice>
      </response_lid><response_lid ident="C" rcardinality="Single">
        <material><mattext texttype="text/plain">Beds near the fence received less afternoon sun.</mattext></material>
        <render_choice shuffle="No"><response_label ident="G1"><material><mattext texttype="text/plain">Mulch helped reduce water loss from the soil.</mattext></material></response_label><response_label ident="G2"><material><mattext texttype="text/plain">Bare soil may need more frequent weeding.</mattext></material></response_label><response_label ident="G3"><material><mattext texttype="text/plain">Light exposure was not identical across all beds.</mattext></material></response_label><response_label ident="G4"><material><mattext texttype="text/plain">This maintenance detail does not explain plant growth.</mattext></material></response_label></render_choice>
      </response_lid><response_lid ident="D" rcardinality="Single">
        <material><mattext texttype="text/plain">The garden sign was repainted on Saturday.</mattext></material>
        <render_choice shuffle="No"><response_label ident="G1"><material><mattext texttype="text/plain">Mulch helped reduce water loss from the soil.</mattext></material></response_label><response_label ident="G2"><material><mattext texttype="text/plain">Bare soil may need more frequent weeding.</mattext></material></response_label><response_label ident="G3"><material><mattext texttype="text/plain">Light exposure was not identical across all beds.</mattext></material></response_label><response_label ident="G4"><material><mattext texttype="text/plain">This maintenance detail does not explain plant growth.</mattext></material></response_label></render_choice>
      </response_lid>
    </presentation>
    <resprocessing>
      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0"/></outcomes>
      <respcondition continue="Yes"><conditionvar><varequal respident="A">G1</varequal></conditionvar><setvar action="Add" varname="SCORE">50</setvar></respcondition><respcondition continue="Yes"><conditionvar><varequal respident="B">G2</varequal></conditionvar><setvar action="Add" varname="SCORE">50</setvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;


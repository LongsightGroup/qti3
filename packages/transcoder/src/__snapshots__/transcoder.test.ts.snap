    ],
    "fidelity": "lossy",
    "identifier": "associate-reference",
    "mappings": [
      {
        "affectedPaths": [
          "/itemBody/interactions/0",
        ],
        "diagnosticCodes": [
          "profile.blackboard.associate.manual_fallback",
        ],
        "emittedInteraction": "extendedTextInteraction",
        "fallback": "extended-text",

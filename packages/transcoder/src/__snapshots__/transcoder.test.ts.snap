        <qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield>
        <qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield>
        <qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>A,B,C,D</fieldentry></qtimetadatafield>
        <qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>AQ_inlineChoice-reference</fieldentry></qtimetadatafield>
      </qtimetadata>
    </itemmetadata>
    <presentation>
      <material><mattext texttype="text/html">&lt;p&gt;Read the sentence from a school-news article and choose the words that make the account accurate.&lt;/p&gt;&lt;p&gt;After a three-week pilot, the cafeteria team reported that the reusable tray program , and the strongest evidence was the .&lt;/p&gt;</mattext></material>


      <response_lid ident="response1" rcardinality="Single">
        <render_choice shuffle="No"><response_label ident="A"><material><mattext texttype="text/html">reduced lunchroom waste</mattext></material></response_label><response_label ident="B"><material><mattext texttype="text/html">increased disposable packaging</mattext></material></response_label><response_label ident="C"><material><mattext texttype="text/html">left trash levels unchanged</mattext></material></response_label><response_label ident="D"><material><mattext texttype="text/html">stopped food donations</mattext></material></response_label></render_choice>
      </response_lid>
      <response_lid ident="response2" rcardinality="Single">
        <render_choice shuffle="No"><response_label ident="A"><material><mattext texttype="text/html">number of students who bought lunch</mattext></material></response_label><response_label ident="B"><material><mattext texttype="text/html">drop in bags collected after lunch</mattext></material></response_label><response_label ident="C"><material><mattext texttype="text/html">color of the new trays</mattext></material></response_label><response_label ident="D"><material><mattext texttype="text/html">menu posted on Monday</mattext></material></response_label></render_choice>
      </response_lid>
    </presentation>
    <resprocessing>
      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="100"/></outcomes>
      <respcondition continue="No"><conditionvar><varequal respident="response1">A</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition>
      <respcondition continue="No"><conditionvar><varequal respident="response2">B</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;


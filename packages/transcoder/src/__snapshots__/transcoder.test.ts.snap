      <material><mattext texttype="text/html">&lt;p&gt;A media-literacy item asks the student to connect a source detail with the reason it is useful.&lt;/p&gt;&lt;p&gt;Choose the two details that belong together in a source-evaluation note.&lt;/p&gt;</mattext></material>
      
      
      <response_str ident="response1" rcardinality="Single"><material><mattext texttype="text/plain">Provide a complete written response. Available task elements: Interview with the park ranger who led the restoration project; Firsthand source for project timeline; Anonymous comment on a neighborhood forum; Decorative map border; Weather forecast for next month.</mattext></material><render_fib fibtype="String" prompt="Box" rows="8" columns="72"><response_label ident="answer1" rshuffle="No"></response_label></render_fib></response_str>
    </presentation>

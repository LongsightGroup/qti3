  "xml": "<?xml version="1.0" encoding="UTF-8"?>
<assessmentItem xmlns="http://www.imsglobal.org/xsd/imsqti_v2p1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqti_v2p1 https://www.imsglobal.org/xsd/imsqti_v2p1p2.xsd" identifier="associate-reference" title="associate-reference" adaptive="false" timeDependent="false" xml:lang="en">
  <responseDeclaration identifier="RESPONSE" cardinality="single" baseType="string"></responseDeclaration>
  <outcomeDeclaration identifier="SCORE" cardinality="single" baseType="float"><defaultValue><value>0</value></defaultValue></outcomeDeclaration>

  <itemBody><p>A media-literacy item asks the student to connect a source detail with the reason it is useful.</p><extendedTextInteraction responseIdentifier="RESPONSE"><prompt>Choose the two details that belong together in a source-evaluation note.<div><p>Source options:</p><ul><li>Interview with the park ranger who led the restoration project</li><li>Firsthand source for project timeline</li><li>Anonymous comment on a neighborhood forum</li><li>Decorative map border</li><li>Weather forecast for next month</li></ul></div></prompt></extendedTextInteraction></itemBody>

</assessmentItem>",
}
`;

exports[`qti3 transcoder evidence matrix > blackboard-question-banks@1 > transcodes choice 1`] = `
{
  "diagnostics": [
    {
      "code": "profile.blackboard.response_processing.omitted",
      "message": "Removed optional QTI response processing because Blackboard skips items that include it. Review scoring after import.",
      "path": "/responseProcessing",

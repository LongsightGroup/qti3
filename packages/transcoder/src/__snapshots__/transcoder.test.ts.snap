      </qtimetadata>
    </itemmetadata>
    <presentation>
      <material><mattext texttype="text/html">&lt;p&gt;A science-planning item asks the student to arrange investigation steps in order.&lt;/p&gt;&lt;p&gt;A science class is planning a fair test of how light affects seedling growth. Put the investigation steps in the best order.&lt;/p&gt;</mattext></material>


      <response_lid ident="response_POS_1" rcardinality="Single">
        <material><mattext texttype="text/plain">Step 1</mattext></material>
        <render_choice shuffle="No"><response_label ident="A"><material><mattext texttype="text/plain">Set up identical trays with the same soil, seed type, and water schedule.</mattext></material></response_label><response_label ident="B"><material><mattext texttype="text/plain">Place one tray in full light and one tray in reduced light for the same number of days.</mattext></material></response_label><response_label ident="C"><material><mattext texttype="text/plain">Measure and compare seedling height at the end of the trial.</mattext></material></response_label><response_label ident="D"><material><mattext texttype="text/plain">Use the measurements to write a conclusion about how light affected growth.</mattext></material></response_label></render_choice>
      </response_lid><response_lid ident="response_POS_2" rcardinality="Single">
        <material><mattext texttype="text/plain">Step 2</mattext></material>
        <render_choice shuffle="No"><response_label ident="A"><material><mattext texttype="text/plain">Set up identical trays with the same soil, seed type, and water schedule.</mattext></material></response_label><response_label ident="B"><material><mattext texttype="text/plain">Place one tray in full light and one tray in reduced light for the same number of days.</mattext></material></response_label><response_label ident="C"><material><mattext texttype="text/plain">Measure and compare seedling height at the end of the trial.</mattext></material></response_label><response_label ident="D"><material><mattext texttype="text/plain">Use the measurements to write a conclusion about how light affected growth.</mattext></material></response_label></render_choice>
      </response_lid><response_lid ident="response_POS_3" rcardinality="Single">
        <material><mattext texttype="text/plain">Step 3</mattext></material>
        <render_choice shuffle="No"><response_label ident="A"><material><mattext texttype="text/plain">Set up identical trays with the same soil, seed type, and water schedule.</mattext></material></response_label><response_label ident="B"><material><mattext texttype="text/plain">Place one tray in full light and one tray in reduced light for the same number of days.</mattext></material></response_label><response_label ident="C"><material><mattext texttype="text/plain">Measure and compare seedling height at the end of the trial.</mattext></material></response_label><response_label ident="D"><material><mattext texttype="text/plain">Use the measurements to write a conclusion about how light affected growth.</mattext></material></response_label></render_choice>
      </response_lid><response_lid ident="response_POS_4" rcardinality="Single">
        <material><mattext texttype="text/plain">Step 4</mattext></material>
        <render_choice shuffle="No"><response_label ident="A"><material><mattext texttype="text/plain">Set up identical trays with the same soil, seed type, and water schedule.</mattext></material></response_label><response_label ident="B"><material><mattext texttype="text/plain">Place one tray in full light and one tray in reduced light for the same number of days.</mattext></material></response_label><response_label ident="C"><material><mattext texttype="text/plain">Measure and compare seedling height at the end of the trial.</mattext></material></response_label><response_label ident="D"><material><mattext texttype="text/plain">Use the measurements to write a conclusion about how light affected growth.</mattext></material></response_label></render_choice>
      </response_lid>
    </presentation>
    <resprocessing>
      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="100"/></outcomes>
      <respcondition continue="Yes"><conditionvar><varequal respident="response_POS_1">A</varequal></conditionvar><setvar action="Add" varname="SCORE">25</setvar></respcondition><respcondition continue="Yes"><conditionvar><varequal respident="response_POS_2">B</varequal></conditionvar><setvar action="Add" varname="SCORE">25</setvar></respcondition><respcondition continue="Yes"><conditionvar><varequal respident="response_POS_3">C</varequal></conditionvar><setvar action="Add" varname="SCORE">25</setvar></respcondition><respcondition continue="Yes"><conditionvar><varequal respident="response_POS_4">D</varequal></conditionvar><setvar action="Add" varname="SCORE">25</setvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}

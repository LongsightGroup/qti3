  </responseCondition>
  <responseCondition>
    <responseIf>
      <match>
        <variable identifier="RESPONSE_OUTCOME"/>
        <correct identifier="RESPONSE_OUTCOME"/>
      </match>
      <setOutcomeValue identifier="SCORE">
        <sum>
          <variable identifier="SCORE"/>
          <baseValue baseType="float">1</baseValue>
        </sum>
      </setOutcomeValue>
    </responseIf>
  </responseCondition>
</responseProcessing>
</assessmentItem>",
}
`;


      <response_str ident="response1" rcardinality="Single"><material><mattext texttype="text/plain">Enter the response as x,y coordinates.</mattext></material><render_fib fibtype="String" prompt="Box" rows="1" columns="30"><response_label ident="answer1" rshuffle="No"></response_label></render_fib></response_str>
    </presentation>
    <resprocessing>
      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="100"/></outcomes>
      <respcondition continue="No"><conditionvar><varequal respident="response1">240,88</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;


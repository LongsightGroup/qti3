      <response_str ident="RESPONSE" rcardinality="Single"><material><mattext texttype="text/plain">Enter a value within the stated range.</mattext></material><render_fib fibtype="Decimal" prompt="Box" rows="1" columns="30"></render_fib></response_str>
    </presentation>
    <resprocessing>
      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0"/></outcomes>
      <respcondition continue="Yes"><conditionvar><varequal respident="RESPONSE">2024</varequal></conditionvar><setvar action="Add" varname="SCORE">1</setvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;


      <material><mataudio uri="data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAESsAACJWAAACABAAZGF0YQAAAAA=" audiotype="audio/wav" label="Silent town-hall audio excerpt"></mataudio></material>

      <response_str ident="response1" rcardinality="Single"><material><mattext texttype="text/plain">Describe your response after reviewing the media.</mattext></material><render_fib fibtype="String" prompt="Box" rows="8" columns="72"><response_label ident="answer1" rshuffle="No"></response_label></render_fib></response_str>
    </presentation>
    <resprocessing>
      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="100"/></outcomes>
      <respcondition continue="No"><conditionvar><other/></conditionvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;


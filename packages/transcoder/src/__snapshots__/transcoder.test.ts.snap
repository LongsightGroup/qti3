  xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2.xsd">
  <item ident="match-reference" title="match-reference">
    <itemmetadata>
      <qtimetadata>
        <qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>matching_question</fieldentry></qtimetadatafield>
        <qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield>
        <qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>G1,G2,G3,G4</fieldentry></qtimetadatafield>
        <qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>AQ_match-reference</fieldentry></qtimetadatafield>
      </qtimetadata>
    </itemmetadata>
    <presentation>
      <material><mattext texttype="text/html">&lt;p&gt;A garden-data item asks the student to match observations with reasonable interpretations.&lt;/p&gt;&lt;p&gt;Match each observation from a community garden study with the most reasonable interpretation.&lt;/p&gt;</mattext></material>
      
      
      <response_lid ident="response_A" rcardinality="Single">
        <material><mattext texttype="text/plain">Mulched beds stayed moist two days longer after watering.</mattext></material>
        <render_choice shuffle="No"><response_label ident="G1"><material><mattext texttype="text/plain">Mulch helped reduce water loss from the soil.</mattext></material></response_label><response_label ident="G2"><material><mattext texttype="text/plain">Bare soil may need more frequent weeding.</mattext></material></response_label><response_label ident="G3"><material><mattext texttype="text/plain">Light exposure was not identical across all beds.</mattext></material></response_label><response_label ident="G4"><material><mattext texttype="text/plain">This maintenance detail does not explain plant growth.</mattext></material></response_label></render_choice>
      </response_lid><response_lid ident="response_B" rcardinality="Single">
        <material><mattext texttype="text/plain">Uncovered beds had more weeds by the third week.</mattext></material>
        <render_choice shuffle="No"><response_label ident="G1"><material><mattext texttype="text/plain">Mulch helped reduce water loss from the soil.</mattext></material></response_label><response_label ident="G2"><material><mattext texttype="text/plain">Bare soil may need more frequent weeding.</mattext></material></response_label><response_label ident="G3"><material><mattext texttype="text/plain">Light exposure was not identical across all beds.</mattext></material></response_label><response_label ident="G4"><material><mattext texttype="text/plain">This maintenance detail does not explain plant growth.</mattext></material></response_label></render_choice>
      </response_lid><response_lid ident="response_C" rcardinality="Single">
        <material><mattext texttype="text/plain">Beds near the fence received less afternoon sun.</mattext></material>
        <render_choice shuffle="No"><response_label ident="G1"><material><mattext texttype="text/plain">Mulch helped reduce water loss from the soil.</mattext></material></response_label><response_label ident="G2"><material><mattext texttype="text/plain">Bare soil may need more frequent weeding.</mattext></material></response_label><response_label ident="G3"><material><mattext texttype="text/plain">Light exposure was not identical across all beds.</mattext></material></response_label><response_label ident="G4"><material><mattext texttype="text/plain">This maintenance detail does not explain plant growth.</mattext></material></response_label></render_choice>
      </response_lid><response_lid ident="response_D" rcardinality="Single">
        <material><mattext texttype="text/plain">The garden sign was repainted on Saturday.</mattext></material>
        <render_choice shuffle="No"><response_label ident="G1"><material><mattext texttype="text/plain">Mulch helped reduce water loss from the soil.</mattext></material></response_label><response_label ident="G2"><material><mattext texttype="text/plain">Bare soil may need more frequent weeding.</mattext></material></response_label><response_label ident="G3"><material><mattext texttype="text/plain">Light exposure was not identical across all beds.</mattext></material></response_label><response_label ident="G4"><material><mattext texttype="text/plain">This maintenance detail does not explain plant growth.</mattext></material></response_label></render_choice>
      </response_lid>
    </presentation>
    <resprocessing>
      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="100"/></outcomes>
      <respcondition continue="Yes"><conditionvar><varequal respident="response_A">G1</varequal></conditionvar><setvar action="Add" varname="SCORE">50</setvar></respcondition><respcondition continue="Yes"><conditionvar><varequal respident="response_B">G2</varequal></conditionvar><setvar action="Add" varname="SCORE">50</setvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;


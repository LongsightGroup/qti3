      <respcondition continue="Yes"><conditionvar><varequal respident="RESPONSE_OUTCOME">B</varequal></conditionvar><setvar action="Add" varname="SCORE">1</setvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;


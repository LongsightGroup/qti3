    <resprocessing>
      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="100"/></outcomes>
      <respcondition continue="No"><conditionvar><and><varequal respident="response1">PAIR_A_G1</varequal><varequal respident="response1">PAIR_B_G2</varequal><not><varequal respident="response1">PAIR_A_G2</varequal></not><not><varequal respident="response1">PAIR_B_G1</varequal></not><not><varequal respident="response1">PAIR_C_G1</varequal></not><not><varequal respident="response1">PAIR_C_G2</varequal></not><not><varequal respident="response1">PAIR_D_G1</varequal></not><not><varequal respident="response1">PAIR_D_G2</varequal></not></and></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition>

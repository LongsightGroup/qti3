      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="100"/></outcomes>
      <respcondition continue="No"><conditionvar><other/></conditionvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;

exports[`qti3 transcoder evidence matrix > canvas-classic-quizzes@1 > transcodes choice 1`] = `
{
  "diagnostics": [],
  "report": {
    "affectedPaths": [],
    "diagnosticCodes": [],
    "fidelity": "exact",
    "identifier": "choice-reference",
    "mappings": [
      {
        "affectedPaths": [],
        "diagnosticCodes": [],
        "emittedInteraction": "response_lid",
        "fallback": undefined,
        "fidelity": "exact",
        "index": 0,
        "scoring": "automatic",
        "sourceInteraction": "choice",
      },
    ],
    "sourcePath": "choice.xml",
  },
  "xml": "<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2.xsd">
  <item ident="choice-reference" title="choice-reference">
    <itemmetadata>
      <qtimetadata>
        <qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield>
        <qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield>
        <qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>A,B,C,D,E</fieldentry></qtimetadatafield>
        <qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>AQ_choice-reference</fieldentry></qtimetadatafield>
      </qtimetadata>
    </itemmetadata>
    <presentation>
      <material><mattext texttype="text/html">&lt;p&gt;A civics item asks the student to choose the strongest evidence for a local-news claim.&lt;/p&gt;&lt;p&gt;A local newspaper reports that the library&amp;apos;s weekend tutoring program improved attendance. Which detail would best support that claim?&lt;/p&gt;</mattext></material>
      
      
      <response_lid ident="response1" rcardinality="Single">
        <render_choice shuffle="No"><response_label ident="A"><material><mattext texttype="text/html">Attendance records show that average Saturday visits rose from 42 to 68 students after tutoring began.</mattext></material></response_label><response_label ident="B"><material><mattext texttype="text/html">The library repainted the study room in a brighter color during spring break.</mattext></material></response_label><response_label ident="C"><material><mattext texttype="text/html">Several tutors said they enjoyed helping younger students with homework.</mattext></material></response_label><response_label ident="D"><material><mattext texttype="text/html">The tutoring flyers used the same logo as the summer reading program.</mattext></material></response_label><response_label ident="E"><material><mattext texttype="text/html">The library closes one hour earlier on Sundays than it does on Saturdays.</mattext></material></response_label></render_choice>
      </response_lid>
    </presentation>
    <resprocessing>
      <outcomes><decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="100"/></outcomes>
      <respcondition continue="No"><conditionvar><varequal respident="response1">A</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition>
    </resprocessing>
  </item>
</questestinterop>",
}
`;


        <qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>AQ_gapMatch-reference</fieldentry></qtimetadatafield>
      </qtimetadata>
    </itemmetadata>
    <presentation>
      <material><mattext texttype="text/html">&lt;p&gt;A science vocabulary item asks the student to complete a field-notes sentence from a word bank.&lt;/p&gt;&lt;p&gt;Complete the field-notes sentence using the word bank.&lt;/p&gt;</mattext></material>
      
      
      <response_lid ident="response1" rcardinality="Multiple"><material><mattext texttype="text/plain">Select the correct relationships.</mattext></material><render_choice shuffle="No"><response_label ident="PAIR_A_G1"><material><mattext texttype="text/plain">evidence — G1</mattext></material></response_label><response_label ident="PAIR_A_G2"><material><mattext texttype="text/plain">evidence — G2</mattext></material></response_label><response_label ident="PAIR_B_G1"><material><mattext texttype="text/plain">claim — G1</mattext></material></response_label><response_label ident="PAIR_B_G2"><material><mattext texttype="text/plain">claim — G2</mattext></material></response_label><response_label ident="PAIR_C_G1"><material><mattext texttype="text/plain">opinion — G1</mattext></material></response_label><response_label ident="PAIR_C_G2"><material><mattext texttype="text/plain">opinion — G2</mattext></material></response_label><response_label ident="PAIR_D_G1"><material><mattext texttype="text/plain">caption — G1</mattext></material></response_label><response_label ident="PAIR_D_G2"><material><mattext texttype="text/plain">caption — G2</mattext></material></response_label></render_choice></response_lid>

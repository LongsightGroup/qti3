{
  "name": "@longsightgroup/qti3-migrator",
  "version": "0.10.1",
  "description": "Framework-neutral QTI 1.2 and QTI 2.x to QTI 3 migration utilities.",
  "keywords": [
    "assessment",
    "migration",
    "qti",
    "qti3",
    "typescript",
    "xml"
  ],
  "homepage": "https://github.com/LongsightGroup/qti3/tree/main/packages/migrator#readme",
  "bugs": {
    "url": "https://github.com/LongsightGroup/qti3/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Sam Ottenhoff",
    "url": "https://github.com/ottenhoff"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LongsightGroup/qti3.git",
    "directory": "packages/migrator"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "!dist/**/*.test.*",
    "!dist/test-helpers.*",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/test-helpers.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prepublishOnly": "pnpm --dir ../.. release:check"
  },
  "dependencies": {
    "@longsightgroup/qti3-core": "workspace:*",
    "@longsightgroup/qti3-writer": "workspace:*",
    "@xmldom/xmldom": "^0.8.11",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@longsightgroup/qti3-transcoder": "workspace:*"
  }
}

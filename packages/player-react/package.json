{
  "name": "@longsightgroup/qti3-player-react",
  "version": "0.8.2",
  "description": "React TSX adapter for the qti3 QTI 3 assessment item player web component.",
  "keywords": [
    "assessment",
    "qti",
    "qti3",
    "react",
    "tsx",
    "web-components"
  ],
  "homepage": "https://github.com/LongsightGroup/qti3/tree/main/packages/player-react#readme",
  "bugs": {
    "url": "https://github.com/LongsightGroup/qti3/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Sam Ottenhoff",
    "url": "https://github.com/ottenhoff"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LongsightGroup/qti3.git",
    "directory": "packages/player-react"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "!dist/**/*.test.*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prepublishOnly": "pnpm --dir ../.. release:check"
  },
  "dependencies": {
    "@longsightgroup/qti3-player": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  }
}
